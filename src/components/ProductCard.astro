---
import type { CollectionEntry } from 'astro:content';
import RxBadge from './RxBadge.astro';

interface Props { product: CollectionEntry<'products'> }
const { product } = Astro.props;
const { name, genericName, type, image, strength, packaging, nafdacReg } = product.data;
const details = [strength, packaging, nafdacReg].filter(Boolean);
---
<a
  href={`/products/${product.id}/`}
  class="block w-full rounded-3xl border border-secondary-300 bg-white p-6 transition-shadow hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.34rem)]"
>
  <div class="flex items-center gap-4">
    <h3 class="font-heading text-xl font-medium text-primary-800">{name}</h3>
    <RxBadge type={type} />
  </div>
  {genericName && <p class="mt-2 text-base">{genericName}</p>}

  <div class="mt-5 aspect-[310/268] overflow-hidden bg-neutral-200">
    {image && <img src={image} alt={`${name} pack`} loading="lazy" class="h-full w-full object-cover" />}
  </div>

  <ul class="mt-4 space-y-3 px-2 text-base">
    {details.map((d) => <li>{d}</li>)}
  </ul>
</a>
