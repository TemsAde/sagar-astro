---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro'; // adjust to your layout
import PageHeader from '../../components/PageHeader.astro';


const jobs = (await getCollection('jobs'))
  .filter((j) => j.data.status === 'open')
  .sort((a, b) => b.data.datePosted.getTime() - a.data.datePosted.getTime());

const input =
  'mt-2 w-full rounded-lg border border-primary-500 bg-white px-4 py-3 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600';
const label = 'block text-base font-semibold';
---
<Layout title="Apply | SAGAR Vitaceuticals">
  <PageHeader title="Apply for a role" />

  <section class="mx-auto max-w-3xl px-4 py-12">
    <p id="success" class="hidden rounded-2xl border border-primary-500 bg-primary-50 p-6 text-lg" role="status" tabindex="-1">
      Thank you. We've received your application and will be in touch if your profile matches the role.
    </p>

    <form
      id="apply-form"
      name="career-application"
      method="POST"
      action="/"
      enctype="multipart/form-data"
      data-netlify="true"
      netlify-honeypot="_gotcha"
      class="space-y-6"
      netlify
    >
      <input type="hidden" name="form-name" value="career-application" />
      <!-- Spam trap: real people never see or fill this -->
      <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="fullName" class={label}>Full name</label>
          <input id="fullName" name="fullName" type="text" required autocomplete="name" class={input} />
        </div>
        <div>
          <label for="email" class={label}>Email address</label>
          <input id="email" name="email" type="email" required autocomplete="email" class={input} />
        </div>
        <div>
          <label for="phone" class={label}>Phone number</label>
          <input id="phone" name="phone" type="tel" required autocomplete="tel" class={input} />
        </div>
        <div>
          <label for="linkedin" class={label}>LinkedIn profile <span class="font-normal">(optional)</span></label>
          <input id="linkedin" name="linkedin" type="url" placeholder="https://linkedin.com/in/…" class={input} />
        </div>
      </div>

      <div>
        <label for="address" class={label}>Residential address</label>
        <input id="address" name="address" type="text" required autocomplete="street-address" class={input} />
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="role" class={label}>Role applied for</label>
          <select id="role" name="role" required class={input}>
            <option value="" disabled selected>Select a role</option>
            {jobs.map((j) => <option value={j.data.title} data-slug={j.id}>{j.data.title}</option>)}
            <option value="General application" data-slug="general">General application (role not listed)</option>
          </select>
        </div>
        <div>
          <label for="experience" class={label}>Years of experience</label>
          <select id="experience" name="experience" required class={input}>
            <option value="" disabled selected>Select</option>
            <option>Less than 1 year</option>
            <option>1 to 2 years</option>
            <option>3 to 5 years</option>
            <option>6 to 10 years</option>
            <option>More than 10 years</option>
          </select>
        </div>
        <div>
          <label for="education" class={label}>Highest education level</label>
          <select id="education" name="education" required class={input}>
            <option value="" disabled selected>Select</option>
            <option>SSCE / WAEC</option>
            <option>OND / ND</option>
            <option>HND</option>
            <option>Bachelor's degree</option>
            <option>Postgraduate diploma</option>
            <option>Master's degree</option>
            <option>Doctorate</option>
            <option>Professional qualification</option>
          </select>
        </div>
      </div>

      <div>
        <label for="message" class={label}>Cover letter or message</label>
        <textarea id="message" name="message" rows="6" class={input}></textarea>
      </div>

      <div>
        <label for="cv" class={label}>CV / Resume</label>
        <input
          id="cv" name="cv" type="file" required accept=".pdf,.doc,.docx"
          class="mt-2 block w-full rounded-lg border border-primary-500 bg-white p-3 text-base file:mr-4 file:rounded file:border-0 file:bg-primary-800 file:px-4 file:py-2 file:font-semibold file:text-white"
        />
        <p class="mt-2 text-sm text-neutral-700">PDF, DOC or DOCX, up to 5 MB.</p>
      </div>

      <p class="text-sm text-neutral-700">
        We use your details only to assess your application.
      </p>

      <p id="error" class="hidden rounded-lg border border-red-600 bg-red-50 p-4 text-red-800" role="alert"></p>

      <button
        id="submit" type="submit"
        class="rounded bg-primary-800 px-6 py-3 font-semibold text-white hover:bg-primary-900 disabled:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-800"
      >
        Submit application
      </button>
    </form>
  </section>
</Layout>

<script>
  const MAX_BYTES = 5 * 1024 * 1024;
  const form = document.querySelector<HTMLFormElement>('#apply-form')!;
  const success = document.querySelector<HTMLElement>('#success')!;
  const error = document.querySelector<HTMLElement>('#error')!;
  const submit = document.querySelector<HTMLButtonElement>('#submit')!;
  const role = form.querySelector<HTMLSelectElement>('#role')!;

  // Preselect the role passed from the careers page (?role=slug)
  const slug = new URLSearchParams(location.search).get('role');
  if (slug) {
    const match = [...role.options].find((o) => o.dataset.slug === slug);
    if (match) role.value = match.value;
  }

  const fail = (msg: string) => {
    error.textContent = msg;
    error.classList.remove('hidden');
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.classList.add('hidden');

    const file = form.querySelector<HTMLInputElement>('#cv')!.files?.[0];
    if (file && file.size > MAX_BYTES) return fail('Your CV is larger than 5 MB. Please upload a smaller file.');
    if (file && !/\.(pdf|docx?)$/i.test(file.name)) return fail('Please upload your CV as a PDF, DOC or DOCX file.');

    submit.disabled = true;
    submit.textContent = 'Sending…';
    try {
      // Netlify Forms: POST the FormData to the site root. Do not set a Content-Type
      // header by hand, the browser must add the multipart boundary for the CV upload.
      const res = await fetch('/', { method: 'POST', body: new FormData(form) });
      if (!res.ok) throw new Error(String(res.status));
      form.classList.add('hidden');
      success.classList.remove('hidden');
      success.focus();
    } catch {
      fail('Something went wrong and your application was not sent. Please try again, or contact us directly.');
      submit.disabled = false;
      submit.textContent = 'Submit application';
    }
  });
</script>
